# Generated by Cargo
# will have compiled files and executables
/target/

# Published libraries do not use their packaged lockfile for downstream
# resolution, but this workspace tracks its root lockfile so CI and releases
# validate one reviewed dependency graph.
**/Cargo.lock
!/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

.idea
.vscode

# cargo-fuzz (libFuzzer)
**/fuzz/target/
**/fuzz/artifacts/
**/fuzz/corpus/

